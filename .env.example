# Copy this file to .env.local and fill in your own account values.
# Never commit .env.local or real credentials.

# Supabase Auth and private Storage
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# PostgreSQL connection string from Supabase Connect.
# Replace the password placeholder completely and percent-encode special characters.
# DATABASE_URL=postgresql://postgres.PROJECT_REF:ENCODED_PASSWORD@POOLER_HOST:5432/postgres
DATABASE_URL=

# The NEXT_PUBLIC_SUPABASE_URL and NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY aliases
# are also supported. Do not prefix server secrets with NEXT_PUBLIC_.

# Public Google Calendar appointment-schedule booking URL (optional)
APPOINTMENT_BOOKING_URL=

# Paystack hosted checkout: start with a test secret key.
PAYSTACK_SECRET_KEY=
# Dedicated whsec_ signing secret, if enabled for the selected Paystack mode.
PAYSTACK_WEBHOOK_SECRET=
# Match the exact app origin and development port; use HTTPS in production.
APP_URL=http://localhost:3000

# Public HTTPS site origin for SEO (falls back to APP_URL when public HTTPS)
SITE_URL=
